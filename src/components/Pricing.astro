---
---

<section id="pricing" class="pricing" role="region" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section-header">
      <h2 id="pricing-title" class="section-title">Empieza gratis. Crece cuando quieras.</h2>
      <p class="section-subtitle">
        Un plan gratuito real, sin letra pequeña. Y en todos los planes pagos, las mismas
        funciones completas — solo cambia cuánta capacidad de uso necesitas.
      </p>
    </header>

    <!-- Pricing Carousel -->
    <div class="pricing-carousel" role="region" aria-roledescription="carrusel" aria-label="Planes de precios">
      <button class="carousel-arrow prev" id="pricing-prev" aria-label="Ver plan anterior">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
      </button>
      <div class="pricing-grid" id="pricing-track" role="list" aria-label="Planes de precios disponibles">
      <article class="pricing-card free" role="listitem">
        <div class="pricing-icon"><i class="fas fa-store" aria-hidden="true"></i></div>
        <header class="pricing-header">
          <h3>Gratis</h3>
          <div class="price" role="img" aria-label="Precio: gratis para siempre">
            <span class="amount">0</span>
            <span class="period">/siempre</span>
          </div>
          <p class="pricing-desc">Tu punto de venta, sin condiciones</p>
        </header>
        <ul class="pricing-features" role="list">
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Ventas ilimitadas</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Inventario y historial de ventas</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Órdenes para mesas y domicilio</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Funciona offline, sincroniza después</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Factura electrónica DIAN (uso manual)</span>
          </li>
        </ul>
        <a
          class="pricing-btn btn-outline"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Empezar con el plan gratuito, regístrate en Rosiv"
        >
          Empezar gratis
        </a>
        <div class="pricing-note">Sin tarjeta de crédito</div>
      </article>

      <article class="pricing-card pro" role="listitem">
        <div class="pricing-icon"><i class="fas fa-seedling" aria-hidden="true"></i></div>
        <header class="pricing-header">
          <h3>Starter</h3>
          <div class="price" role="img" aria-label="Precio: 21.300 pesos mensuales, IVA incluido">
            <span class="amount">21.300</span>
            <span class="period">/mes</span>
          </div>
          <p class="pricing-desc">Para arrancar con todo desbloqueado</p>
        </header>
        <ul class="pricing-features" role="list">
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Todo del plan Gratis</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
            <span>Factura electrónica DIAN automática</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-robot" aria-hidden="true"></i>
            <span>Empleado virtual con y sin IA</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-chart-line" aria-hidden="true"></i>
            <span>Reportes e inventario avanzado</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-bolt" aria-hidden="true"></i>
            <span>Sincronización instantánea</span>
          </li>
        </ul>
        <div class="pricing-capacity" aria-label="Capacidad base de uso mensual de las funciones avanzadas">
          <div class="capacity-bars">
            <span class="bar filled"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </div>
          <span class="capacity-label">Capacidad base</span>
          <span class="capacity-hint">Cuánto puedes usar las funciones avanzadas cada mes</span>
        </div>
        <a
          class="pricing-btn btn-outline"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Elegir el plan Starter en Rosiv"
        >
          Elegir Starter
        </a>
      </article>

      <article class="pricing-card growth featured" role="listitem">
        <div class="pricing-badge" aria-label="Plan más popular">
          <i class="fas fa-crown" aria-hidden="true"></i>
          Más Popular
        </div>
        <div class="pricing-icon"><i class="fas fa-chart-line" aria-hidden="true"></i></div>
        <header class="pricing-header">
          <h3>Growth</h3>
          <div class="price" role="img" aria-label="Precio: 71.300 pesos mensuales, IVA incluido">
            <span class="amount">71.300</span>
            <span class="period">/mes</span>
          </div>
          <p class="pricing-desc">Para negocios que ya se mueven</p>
        </header>
        <p class="pricing-same">Todo lo de Starter, con más capacidad</p>
        <div class="pricing-capacity" aria-label="Capacidad: aproximadamente 5 veces la de Starter para el uso mensual de las funciones avanzadas">
          <div class="capacity-bars">
            <span class="bar filled"></span>
            <span class="bar filled"></span>
            <span class="bar"></span>
          </div>
          <span class="capacity-label">~5x la capacidad de Starter</span>
          <span class="capacity-hint">Cuánto puedes usar las funciones avanzadas cada mes</span>
        </div>
        <a
          class="pricing-btn btn-primary"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Elegir el plan Growth en Rosiv"
        >
          Elegir Growth
        </a>
      </article>

      <!--
      <article class="pricing-card scale" role="listitem">
        <div class="pricing-icon"><i class="fas fa-rocket" aria-hidden="true"></i></div>
        <header class="pricing-header">
          <h3>Scale</h3>
          <div class="price" role="img" aria-label="Precio: 178.400 pesos mensuales, IVA incluido">
            <span class="amount">178.400</span>
            <span class="period">/mes</span>
          </div>
          <p class="pricing-desc">Para negocios de alto volumen</p>
        </header>
        <p class="pricing-same">Todo lo de Growth, con más capacidad</p>
        <div class="pricing-capacity" aria-label="Capacidad: aproximadamente 18 veces la de Starter">
          <div class="capacity-bars">
            <span class="bar filled"></span>
            <span class="bar filled"></span>
            <span class="bar filled"></span>
          </div>
          <span class="capacity-label">~18x la capacidad de Starter</span>
        </div>
        <a
          class="pricing-btn btn-outline"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Elegir el plan Scale en Rosiv"
        >
          Elegir Scale
        </a>
      </article>
      -->

      <article class="pricing-card scale" role="listitem">
        <div class="pricing-icon"><i class="fas fa-rocket" aria-hidden="true"></i></div>
        <header class="pricing-header">
          <h3>Elite</h3>
          <div class="price" role="img" aria-label="Precio: 416.400 pesos mensuales, IVA incluido">
            <span class="amount">416.400</span>
            <span class="period">/mes</span>
          </div>
          <p class="pricing-desc">Para negocios de alto volumen</p>
        </header>
        <p class="pricing-same">Todo lo de Growth, con máxima capacidad</p>
        <div class="pricing-capacity" aria-label="Capacidad: aproximadamente 51 veces la de Starter para el uso mensual de las funciones avanzadas">
          <div class="capacity-bars">
            <span class="bar filled"></span>
            <span class="bar filled"></span>
            <span class="bar filled"></span>
          </div>
          <span class="capacity-label">~51x la capacidad de Starter</span>
          <span class="capacity-hint">Cuánto puedes usar las funciones avanzadas cada mes</span>
        </div>
        <a
          class="pricing-btn btn-outline"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Elegir el plan Elite en Rosiv"
        >
          Elegir Elite
        </a>
      </article>
      </div>
      <button class="carousel-arrow next" id="pricing-next" aria-label="Ver plan siguiente">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
    <div class="carousel-dots" id="pricing-dots" role="tablist" aria-label="Selecciona un plan">
      <button class="carousel-dot active" data-index="0" role="tab" aria-selected="true" aria-label="Ver Plan Gratis"></button>
      <button class="carousel-dot" data-index="1" role="tab" aria-selected="false" aria-label="Ver Plan Starter"></button>
      <button class="carousel-dot" data-index="2" role="tab" aria-selected="false" aria-label="Ver Plan Growth"></button>
      <button class="carousel-dot" data-index="3" role="tab" aria-selected="false" aria-label="Ver Plan Elite"></button>
    </div>

    <p class="pricing-footnote">
      <i class="fas fa-shield-heart" aria-hidden="true"></i>
      Te avisamos antes de llegar al límite de tu capacidad, para que subas de plan cuando
      quieras — sin compra de créditos ni sorpresas.
    </p>

    <p class="pricing-cta-enterprise">
      ¿Tienes varias sedes o necesitas algo a medida?
      <a href="https://wa.me/573000000000" target="_blank" rel="noopener noreferrer">
        Habla con ventas <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>
    </p>

    <!-- Simulador de capacidad -->
    <section class="capacity-sim" aria-labelledby="capacity-sim-title">
      <header class="capacity-sim-header">
        <span class="capacity-sim-eyebrow">
          <i class="fas fa-gauge-high" aria-hidden="true"></i>
          Ponle a prueba tu plan
        </span>
        <h3 id="capacity-sim-title">¿Cuánto te alcanza?</h3>
        <p>Mueve los controles y descubre qué tanto se llena tu tanque de capacidad cada mes</p>
      </header>

      <div class="capacity-sim-body">
        <div class="capacity-sim-controls">
          <div class="sim-control">
            <label for="sim-invoices">
              <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
              Facturas electrónicas al mes
              <span class="sim-value" id="sim-invoices-value">0</span>
            </label>
            <input type="range" id="sim-invoices" min="0" max="999" step="1" value="0" />
          </div>

          <div class="sim-control">
            <label for="sim-ia">
              <i class="fas fa-robot" aria-hidden="true"></i>
              Tareas de tu empleado IA al mes
              <span class="sim-value" id="sim-ia-value">0</span>
            </label>
            <input type="range" id="sim-ia" min="0" max="999" step="1" value="0" />
          </div>
        </div>

        <div class="capacity-sim-result">
          <div class="sim-tank" role="img" aria-label="Medidor de capacidad usada">
            <div class="sim-tank-fill" id="sim-tank-fill"></div>
            <div class="sim-tank-face" id="sim-tank-face">
              <i class="fas fa-battery-empty" aria-hidden="true"></i>
            </div>
          </div>
          <p class="sim-plan-label">Te alcanza con</p>
          <p class="sim-plan-name" id="sim-plan-name">Gratis</p>
          <p class="sim-message" id="sim-message">Mueve los controles para empezar a llenar el tanque 👆</p>
          <a
            class="pricing-btn btn-primary sim-cta"
            id="sim-cta"
            href="https://web.rosivhub.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver este plan
          </a>
        </div>
      </div>
    </section>
  </div>
</section>
