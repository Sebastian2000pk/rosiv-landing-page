---
---

<section id="pricing" class="pricing" role="region" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section-header">
      <h2 id="pricing-title" class="section-title">Empieza gratis. Crece cuando quieras.</h2>
      <p class="section-subtitle">
        Un plan gratuito real, sin letra pequeña, y un plan pago que crece con tu negocio
      </p>
    </header>

    <!-- Pricing Carousel -->
    <div class="pricing-carousel" role="region" aria-roledescription="carrusel" aria-label="Planes de precios">
      <button class="carousel-arrow prev" id="pricing-prev" aria-label="Ver plan anterior">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
      </button>
      <div class="pricing-grid" id="pricing-track" role="list" aria-label="Planes de precios disponibles">
      <article class="pricing-card free" role="listitem">
        <header class="pricing-header">
          <h3>Plan Gratis</h3>
          <div class="price" role="img" aria-label="Precio: gratis para siempre">
            <span class="currency">$</span>
            <span class="amount">0</span>
            <span class="period">/siempre</span>
          </div>
          <p class="pricing-desc">Perfecto para empezar tu negocio</p>
        </header>
        <ul class="pricing-features" role="list">
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Ventas ilimitadas</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Gestión básica de inventario</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Reportes básicos</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Funciona offline</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Soporte por WhatsApp</span>
          </li>
          <li class="feature-item disabled">
            <i class="fas fa-times" aria-hidden="true"></i>
            <span>Sin factura electrónica DIAN</span>
          </li>
          <li class="feature-item disabled">
            <i class="fas fa-times" aria-hidden="true"></i>
            <span>Sin envío automático por WhatsApp</span>
          </li>
        </ul>
        <a
          class="pricing-btn btn-outline"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Empezar con el plan gratuito, regístrate en Rosiv"
        >
          <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i>
          Empezar gratis
        </a>
        <div class="pricing-note">No requiere tarjeta de crédito</div>
      </article>

      <article class="pricing-card pro featured" role="listitem">
        <div class="pricing-badge" aria-label="Plan más popular">
          <i class="fas fa-crown" aria-hidden="true"></i>
          Más Popular
        </div>
        <header class="pricing-header">
          <h3>Plan Pro</h3>
          <div class="price" role="img" aria-label="Precio: entre 28.000 y 35.000 pesos mensuales">
            <span class="currency">$</span>
            <span class="amount">28.000 - 35.000</span>
            <span class="period">/mes</span>
          </div>
          <p class="pricing-desc">Para negocios en crecimiento</p>
        </header>
        <ul class="pricing-features" role="list">
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Todo del Plan Gratis</span>
          </li>
          <li class="feature-item featured">
            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
            <span>Factura electrónica DIAN</span>
          </li>
          <li class="feature-item featured">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span>Envío por WhatsApp (muy pronto)</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-chart-line" aria-hidden="true"></i>
            <span>Reportes avanzados</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-users" aria-hidden="true"></i>
            <span>Varios usuarios de tu equipo</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-headset" aria-hidden="true"></i>
            <span>Soporte prioritario por WhatsApp</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-star" aria-hidden="true"></i>
            <span>Acceso anticipado a los empleados virtuales</span>
          </li>
        </ul>
        <a
          class="pricing-btn btn-primary"
          href="https://web.rosivhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Empezar prueba gratuita del plan Pro, regístrate en Rosiv"
        >
          <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i>
          Probar 7 días gratis
        </a>
        <div class="pricing-trial">Cancela cuando quieras, sin contratos forzosos</div>
      </article>

      <article class="pricing-card enterprise" role="listitem">
        <header class="pricing-header">
          <h3>Plan Empresa</h3>
          <div class="price" role="img" aria-label="Precio personalizado">
            <span class="amount">A medida</span>
          </div>
          <p class="pricing-desc">Para varias sedes o franquicias</p>
        </header>
        <ul class="pricing-features" role="list">
          <li class="feature-item">
            <i class="fas fa-check" aria-hidden="true"></i>
            <span>Todo del Plan Pro</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-building" aria-hidden="true"></i>
            <span>Varias sedes o locales</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-plug" aria-hidden="true"></i>
            <span>Integraciones a medida</span>
          </li>
          <li class="feature-item">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>Acompañamiento dedicado</span>
          </li>
        </ul>
        <a
          class="pricing-btn btn-outline"
          href="https://wa.me/573000000000"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hablar con ventas por WhatsApp"
        >
          <i class="fab fa-whatsapp" aria-hidden="true"></i>
          Hablar con ventas
        </a>
        <div class="pricing-note">Implementación acompañada</div>
      </article>
      </div>
      <button class="carousel-arrow next" id="pricing-next" aria-label="Ver plan siguiente">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
    <div class="carousel-dots" id="pricing-dots" role="tablist" aria-label="Selecciona un plan">
      <button class="carousel-dot active" data-index="0" role="tab" aria-selected="true" aria-label="Ver Plan Gratis"></button>
      <button class="carousel-dot" data-index="1" role="tab" aria-selected="false" aria-label="Ver Plan Pro"></button>
      <button class="carousel-dot" data-index="2" role="tab" aria-selected="false" aria-label="Ver Plan Empresa"></button>
    </div>
  </div>
</section>
