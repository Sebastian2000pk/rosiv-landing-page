---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  pubDate: Date;
  updatedDate?: Date;
  keywords?: string;
  faq?: FaqItem[];
}

const { title, description, path, pubDate, updatedDate, keywords, faq = [] } =
  Astro.props;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: "es-CO",
    articleSection: "Facturación electrónica y punto de venta en Colombia",
    author: {
      "@type": "Organization",
      name: "Rosiv",
      url: "https://rosivhub.com",
    },
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
      logo: {
        "@type": "ImageObject",
        url: "https://rosivhub.com/icon-512x512.png",
      },
    },
    mainEntityOfPage: new URL(path, Astro.site).toString(),
  },
  ...(faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rosiv", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: title, item: new URL(path, Astro.site).toString() },
    ],
  },
];

const dateFormatted = pubDate.toLocaleDateString("es-CO", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${title} | Blog Rosiv`}
  description={description}
  path={path}
  type="article"
  keywords={keywords}
  jsonLd={jsonLd}
>
  <Navbar />
  <article class="blog-post">
    <div class="blog-post-container">
      <a href="/blog" class="blog-post-back">&larr; Volver al blog</a>
      <header class="blog-post-header">
        <p class="blog-post-date">{dateFormatted}</p>
        <h1 class="blog-post-title">{title}</h1>
      </header>
      <div class="blog-post-content">
        <slot />
      </div>
      {
        faq.length > 0 && (
          <section class="blog-post-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Preguntas frecuentes</h2>
            {faq.map((item) => (
              <details class="blog-post-faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )
      }
    </div>
  </article>
  <Footer />
</Layout>
