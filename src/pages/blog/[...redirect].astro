---
import { BLOG_REDIRECTS } from "../../data/blog-redirects.mjs";

/**
 * Redirects de slugs viejos del blog (lista en src/data/blog-redirects.mjs).
 *
 * GitHub Pages no soporta redirects 301 del servidor, así que se emite una página
 * con <link rel="canonical"> y meta refresh instantáneo, que Google trata como
 * redirect permanente: consolida la señal en el destino y el visitante llega igual.
 * Sin noindex a propósito: mezclado con canonical, Google puede descartar la URL
 * en vez de pasarle su señal al destino.
 */
export function getStaticPaths() {
  return Object.entries(BLOG_REDIRECTS).map(([from, to]) => ({
    params: { redirect: from },
    // Con barra final: es la forma canónica del sitio (ver Layout.astro).
    props: { to: to.endsWith("/") ? to : `${to}/` },
  }));
}

const { to } = Astro.props;
const target = new URL(to, Astro.site).toString();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Redirigiendo…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>Esta página se movió. Si no te redirige, <a href={to}>continúa aquí</a>.</p>
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
  </body>
</html>
