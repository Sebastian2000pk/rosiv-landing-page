---
/**
 * Redirects de los slugs viejos que llevaban el año.
 *
 * Los posts anuales (topes, régimen simple, calendario, salario mínimo) pasaron a
 * slugs sin año para no perder autoridad cada enero — ver MANTENIMIENTO-SEO.md.
 * GitHub Pages no soporta redirects 301 del servidor, así que se emite una página
 * con <link rel="canonical"> y meta refresh: Google consolida la señal en el
 * destino y el visitante llega igual.
 *
 * Se pueden borrar estas entradas cuando Search Console deje de reportar tráfico
 * a las URLs viejas (~6 meses).
 */
export function getStaticPaths() {
  // Definido acá dentro: getStaticPaths se evalúa aislado del resto del frontmatter.
  const REDIRECTS: Record<string, string> = {
    "topes-para-facturar-electronicamente-2026": "/blog/topes-para-facturar-electronicamente",
    "tabla-regimen-simple-tienda-restaurante-2026": "/blog/tabla-regimen-simple-tienda-restaurante",
    "calendario-tributario-2026-tienda-restaurante": "/blog/calendario-tributario-tienda-restaurante",
    "cuanto-cuesta-un-empleado-2026-salario-minimo": "/blog/cuanto-cuesta-un-empleado-salario-minimo",
  };

  return Object.entries(REDIRECTS).map(([from, to]) => ({
    params: { redirect: from },
    props: { to },
  }));
}

const { to } = Astro.props;
const target = new URL(to, Astro.site).toString();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Redirigiendo…</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>Esta página se movió. Si no te redirige, <a href={to}>continúa aquí</a>.</p>
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
  </body>
</html>
