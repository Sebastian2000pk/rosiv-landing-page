---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog Rosiv - Guías de facturación DIAN y POS para negocios en Colombia"
  description="Guías simples sobre facturación electrónica DIAN, punto de venta (POS) y digitalización para tenderos, restaurantes familiares y peluquerías en Colombia."
  path="/blog"
>
  <Navbar />
  <section class="blog-section">
    <div class="container">
      <header class="section-header">
        <h1 class="section-title">Blog Rosiv</h1>
        <p class="section-subtitle">
          Guías simples sobre facturación electrónica, punto de venta y
          digitalización para tenderos, restaurantes familiares y
          peluquerías en Colombia.
        </p>
      </header>
      <div class="blog-grid">
        {
          posts.map((post) => (
            <a class="blog-card" href={`/blog/${post.id}`}>
              <span class="blog-card-date">
                {post.data.pubDate.toLocaleDateString("es-CO", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="blog-card-cta">Leer más &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <Footer />
</Layout>
