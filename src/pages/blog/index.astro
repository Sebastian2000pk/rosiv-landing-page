---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const description =
  "Guías simples sobre facturación electrónica DIAN, punto de venta (POS) y digitalización para tenderos, restaurantes familiares y peluquerías en Colombia.";

const blogURL = new URL("/blog/", Astro.site).toString();

// El índice del blog era la única página del sitio sin datos estructurados.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Blog Rosiv",
    description,
    url: blogURL,
    inLanguage: "es-CO",
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
      url: new URL("/", Astro.site).toString(),
      logo: {
        "@type": "ImageObject",
        url: new URL("/icon-512x512.png", Astro.site).toString(),
      },
    },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
      author: {
        "@type": "Organization",
        name: "Rosiv",
        url: new URL("/", Astro.site).toString(),
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Rosiv",
        item: new URL("/", Astro.site).toString(),
      },
      { "@type": "ListItem", position: 2, name: "Blog", item: blogURL },
    ],
  },
];

const tools = [
  {
    href: "/calcular-precio-venta-margen",
    title: "Calculadora de precio de venta y margen de ganancia",
    description:
      "Escribe cuánto te costó y cuánto quieres ganarte, en pesos. Te decimos el precio de venta y si ese margen es sano para tu negocio.",
    cta: "Calcular ahora",
  },
  {
    href: "/calcular-punto-de-equilibrio",
    title: "Calculadora de punto de equilibrio",
    description:
      "Escribe tus gastos fijos y tu margen promedio. Te decimos cuánto tienes que vender cada día para no perder plata.",
    cta: "Calcular ahora",
  },
  {
    href: "/calculadora-control-de-fiados",
    title: "Control de fiados",
    description:
      "Registra a quién le fiaste, cuánto y desde cuándo. Semáforo de quién debe más y quién lleva más tiempo sin pagar. Entra cada vez que la necesites.",
    cta: "Ver quién me debe",
  },
  {
    href: "/calcular-digito-verificacion-nit",
    title: "Calculadora de dígito de verificación del NIT",
    description:
      "Escribe tu NIT o cédula y obtén el dígito de verificación al instante, con la fórmula oficial de la DIAN.",
    cta: "Calcular ahora",
  },
  {
    href: "/calcular-impoconsumo-iva-restaurante",
    title: "Calculadora de Impoconsumo vs IVA para restaurantes",
    description:
      "Descubre si tu restaurante debe cobrar impoconsumo del 8% o IVA del 19%, y calcula el total al instante.",
    cta: "Calcular ahora",
  },
  {
    href: "/debo-facturar-electronicamente",
    title: "¿Debo facturar electrónicamente?",
    description:
      "Responde 3 preguntas y descubre si tu negocio ya está obligado a facturar electrónicamente ante la DIAN.",
    cta: "Hacer el test",
  },
  {
    href: "/validar-cufe-dian",
    title: "Validar CUFE de factura electrónica",
    description:
      "Verifica si el CUFE de una factura tiene el formato correcto y consúltalo en el catálogo oficial de la DIAN.",
    cta: "Validar ahora",
  },
];
---

<Layout
  title="Blog Rosiv - Guías de facturación DIAN y POS para negocios en Colombia"
  description={description}
  path="/blog"
  jsonLd={jsonLd}
>
  <Navbar />
  <section class="blog-section">
    <div class="container">
      <header class="section-header">
        <h1 class="section-title">Blog Rosiv</h1>
        <p class="section-subtitle">
          Guías simples sobre facturación electrónica, punto de venta y
          digitalización para tenderos, restaurantes familiares y
          peluquerías en Colombia.
        </p>
      </header>
      <div class="blog-grid">
        {
          tools.map((tool) => (
            <a class="blog-card blog-card-tool" href={tool.href}>
              <span class="blog-card-tool-badge">
                <i class="fas fa-calculator" aria-hidden="true" />
                Herramienta gratis
              </span>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
              <span class="blog-card-cta blog-card-tool-cta">{tool.cta} &rarr;</span>
            </a>
          ))
        }
        {
          posts.map((post) => (
            <a class="blog-card" href={`/blog/${post.id}`}>
              <span class="blog-card-date">
                {post.data.pubDate.toLocaleDateString("es-CO", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="blog-card-cta">Leer más &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <Footer />
</Layout>
