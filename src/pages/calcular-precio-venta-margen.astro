---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ToolSidePanel from "../components/tools/ToolSidePanel.astro";
import ToolFaq from "../components/tools/ToolFaq.astro";
import ToolUpsell from "../components/tools/ToolUpsell.astro";
import ToolCrossLinks from "../components/tools/ToolCrossLinks.astro";
import "../styles/tool-page.css";

const title = "Calculadora de Margen de Ganancia y Precio de Venta | Gratis";
const description =
  "Escribe cuánto te costó y cuánto quieres ganarte: calcula tu precio de venta y tu margen de ganancia al instante. Con rangos sanos por tipo de negocio. Gratis, sin registro.";
const path = "/calcular-precio-venta-margen";

const faqItems = [
  {
    question: "¿Cómo calculo el precio de venta de un producto?",
    answer:
      "Súmale al costo lo que quieres ganarte por unidad, en pesos. Por ejemplo: si un producto te cuesta $2.000 y quieres ganarte $800, tu precio de venta es $2.800. Esta calculadora hace esa cuenta al instante y además te muestra qué porcentaje de margen representa sobre ese precio de venta, para que sepas si es un margen sano o no — y si no sabes cuánto ganarte, puede sugerírtelo por ti según tu tipo de negocio.",
  },
  {
    question: "¿Cómo se calcula el margen de ganancia correctamente?",
    answer:
      "El margen de ganancia se calcula dividiendo tu ganancia entre el precio de venta final, no entre el costo. Por ejemplo, si algo te cuesta $2.000 y lo vendes en $2.800 (ganando $800), tu margen es 800 ÷ 2.800 = 28.6%, no 40%. Confundir esta cuenta con el 'recargo sobre el costo' (markup) es un error común que te puede hacer pensar que ganas más de lo que realmente ganas.",
  },
  {
    question: "¿Qué margen de ganancia es normal para una tienda de barrio?",
    answer:
      "En tienda de barrio, donde se vende alto volumen de productos de rotación rápida (gaseosas, snacks, aseo), un margen de 20% o más sobre el precio de venta es un rango sano, porque además de dejar ganancia real tiene que aguantar mermas, productos que se dañan y gastos del día a día. Por debajo de 10% el margen ya es riesgoso.",
  },
  {
    question: "¿Qué margen de ganancia debe tener un restaurante en cada plato?",
    answer:
      "En restaurantes, el estándar de la industria apunta a que el costo de los ingredientes (el 'food cost') no supere entre el 30% y 35% del precio de venta del plato — es decir, un margen sobre ingredientes de 65% o más. Ese margen alto no es exageración: tiene que cubrir el gas, el mesero, el arriendo, el desperdicio de cocina y aun así dejar ganancia real para el dueño.",
  },
  {
    question: "¿Por qué en una peluquería el margen tiene que ser tan alto?",
    answer:
      "Porque en un servicio como peluquería el 'costo' que se mide (insumos: tintes, productos) es pequeño comparado con lo que de verdad cuesta el servicio: el tiempo del estilista, el arriendo del local, los equipos. Por eso ahí un margen sano sobre el precio de venta es alto, alrededor de 55% o más — un margen menor a 35% suele significar que el precio del servicio está mal calculado.",
  },
  {
    question: "¿Esta calculadora sirve si no sé calcular porcentajes?",
    answer:
      "Sí — por eso está hecha así. No tienes que pensar en porcentajes ni sacar cuentas de regla de tres. Escribes cuánto te costó, y si no sabes cuánto ganarte, el botón de 'sugerir ganancia sana' lo calcula por ti según tu tipo de negocio. La calculadora te muestra el precio de venta y el margen ya calculado, con una señal de si es sano o no.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de precio de venta y margen de ganancia",
    url: new URL(path, Astro.site).toString(),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "COP",
    },
    description,
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rosiv", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: "Calculadora de precio de venta y margen", item: new URL(path, Astro.site).toString() },
    ],
  },
];
---

<Layout title={title} description={description} path={path} keywords="calculadora de margen de ganancia, cómo calcular precio de venta, margen de ganancia Colombia, calculadora precio de venta tienda, calcular punto de equilibrio, precio de venta con margen" jsonLd={jsonLd}>
  <Navbar />

  <section class="tool-hero">
    <div class="container tool-hero-grid">
      <div class="tool-hero-main">
        <span class="status-tag live tool-hero-badge">
          <i class="fas fa-sack-dollar" aria-hidden="true"></i>
          En pesos, no en porcentajes
        </span>
        <h1 class="tool-hero-title">
          Calculadora de precio de venta y margen de ganancia
        </h1>
        <p class="tool-hero-subtitle">
          Deja de poner precios al ojo: escribe cuánto te costó y cuánto
          quieres ganarte, en pesos. Te decimos el precio de venta y si
          ese margen te alcanza de verdad — sin que tengas que pensar
          en porcentajes.
        </p>

        <div class="tool-card margin-calculator" role="group" aria-labelledby="margin-calc-label">
          <div class="margin-biz-select" role="radiogroup" aria-label="Tipo de negocio">
            <button type="button" class="margin-biz-chip active" data-biz="tienda">
              <i class="fas fa-store" aria-hidden="true"></i> Tienda
            </button>
            <button type="button" class="margin-biz-chip" data-biz="restaurante">
              <i class="fas fa-utensils" aria-hidden="true"></i> Restaurante
            </button>
            <button type="button" class="margin-biz-chip" data-biz="peluqueria">
              <i class="fas fa-scissors" aria-hidden="true"></i> Peluquería
            </button>
          </div>

          <div class="margin-fields">
            <div class="margin-field">
              <label for="margin-cost" id="margin-cost-label">
                <span id="margin-cost-text">¿Cuánto te cuesta el producto?</span>
              </label>
              <div class="margin-input-wrap">
                <span class="margin-input-prefix">$</span>
                <input
                  id="margin-cost"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="2.000"
                  aria-describedby="margin-error"
                />
              </div>
            </div>
            <div class="margin-field">
              <label for="margin-profit" id="margin-profit-label">
                <span id="margin-profit-text">¿Cuánto quieres ganarte por cada uno?</span>
              </label>
              <div class="margin-input-wrap">
                <span class="margin-input-prefix">$</span>
                <input
                  id="margin-profit"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value="900"
                  aria-describedby="margin-error"
                />
              </div>
              <button type="button" id="margin-suggest-btn" class="margin-suggest-btn">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span id="margin-suggest-text">Sugerir ganancia sana</span>
              </button>
            </div>
          </div>

          <p id="margin-error" class="dv-error" role="alert"></p>

          <div id="margin-result" class="margin-result" aria-live="polite">
            <div class="margin-result-top">
              <div class="margin-result-price">
                <span class="margin-result-label">Precio de venta sugerido</span>
                <span id="margin-price-output" class="margin-result-value">$2.900</span>
              </div>
              <div class="margin-result-pct">
                <span id="margin-pct-output" class="margin-pct-value">31%</span>
                <span class="margin-pct-caption">de margen</span>
              </div>
            </div>
            <div id="margin-signal" class="margin-signal">
              <i id="margin-signal-icon" class="fas fa-circle-check" aria-hidden="true"></i>
              <span id="margin-signal-text">Margen sano para una tienda (20% o más).</span>
            </div>
            <div id="margin-projection" class="margin-projection">
              <label for="margin-volume" class="margin-projection-label">
                Si vendes
                <span class="margin-volume-wrap">
                  <input
                    id="margin-volume"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    value="30"
                    aria-label="Unidades vendidas al mes"
                  />
                </span>
                al mes, te ganas
              </label>
              <span id="margin-projection-output" class="margin-projection-value">$27.000</span>
            </div>
          </div>
        </div>

        <div class="tool-benefits" role="list">
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-bolt" aria-hidden="true"></i>
            </div>
            <span>Resultado en segundos</span>
          </div>
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-traffic-light" aria-hidden="true"></i>
            </div>
            <span>Semáforo por tipo de negocio</span>
          </div>
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-gift" aria-hidden="true"></i>
            </div>
            <span>100% gratis</span>
          </div>
        </div>
      </div>

      <ToolSidePanel
        eyebrow="Después del precio"
        heading="Ya sabes cuánto cobrar. Esto es lo que sigue:"
        items={[
          { label: "Precio con margen sano", done: true },
          { label: "Ese precio aplicado en cada venta" },
          { label: "Saber qué producto deja más plata" },
          { label: "Ajustar precios cuando suba un costo" },
        ]}
      />
    </div>
  </section>

  <section class="tool-explain">
    <div class="container tool-explain-inner">
      <h2>Por qué poner precios "al ojo" te está costando plata</h2>
      <p>
        La mayoría de tenderos, dueños de restaurante y peluqueros ponen
        precios por comparación: "el de la esquina cobra tanto, yo cobro
        parecido" o por costumbre: "siempre lo he vendido a eso". El
        problema es que ninguno de los dos métodos parte de una pregunta
        clave: <strong>¿cuánto te cuesta realmente producir eso que
        vendes?</strong> Sin esa cuenta clara, es fácil estar vendiendo
        casi al costo sin darte cuenta — o peor, perdiendo plata en cada
        venta.
      </p>
      <p>
        Esta calculadora no te pide pensar en porcentajes, porque en el
        día a día de un negocio nadie calcula así. Le das los pesos: lo
        que cuesta y lo que quieres ganarte. Ella hace la conversión a
        margen y, lo más importante, te dice si ese margen es sano para
        tu tipo de negocio específico — porque un margen que es normal en
        una tienda puede ser una alarma roja en una peluquería.
      </p>

      <h3>Ojo con este error: margen no es lo mismo que "cuánto le subiste al costo"</h3>
      <p>
        Mucha gente calcula el margen dividiendo la ganancia entre el
        costo, y no entre el precio de venta — eso en realidad se llama
        recargo o "markup", no margen, y siempre da un número más alto de
        lo que en verdad estás ganando. Si algo te cuesta $2.000 y lo
        vendes en $2.800, tu ganancia de $800 es el <strong>28.6%</strong> del
        precio de venta ($2.800), no el 40% del costo. Esta calculadora
        siempre te muestra el margen real, calculado sobre el precio de
        venta, para que no te lleves una idea equivocada de qué tan bien
        estás vendiendo.
      </p>

      <h3>El margen sano no es el mismo número para todos los negocios</h3>
      <p>
        Un margen de 20% es un rango sano en una tienda de barrio, porque
        la ganancia también se apoya en el volumen: vendes muchas unidades
        de rotación rápida. En un restaurante ese mismo 20% ya es una señal
        de alarma — la industria apunta a un margen de 65% o más sobre el
        precio del plato, porque ese margen tiene que cubrir no solo el
        ingrediente, sino el gas, el mesero, el arriendo y el desperdicio
        de cocina. En una peluquería el margen sano también es alto
        (55% o más), porque el "costo" que se mide es solo el insumo
        (tinte, producto), y el precio real tiene que cubrir además el
        tiempo del estilista, el arriendo y los equipos.
      </p>

      <h3>Qué hacer con el número una vez lo tienes</h3>
      <ul class="tool-list">
        <li>Si el semáforo sale en rojo, ese producto o servicio te está dejando muy poco — considera subir el precio antes de vender más.</li>
        <li>Revisa tus productos o servicios más vendidos primero: ahí un ajuste pequeño de precio se multiplica por el volumen.</li>
        <li>Vuelve a calcular cada vez que suba un costo (proveedor, insumo, arriendo) — el precio que era sano hace 3 meses puede no serlo hoy.</li>
        <li>No compares tu margen con el de otro negocio distinto: compara siempre con el rango sano de tu propio tipo de negocio.</li>
      </ul>
      <p>
        Una vez tienes tus precios claros, el siguiente paso es cobrarlos sin
        fricción en cada venta. Si todavía llevas las cuentas a mano, lee
        <a href="/blog/que-es-un-pos-y-para-que-sirve">qué es un POS</a> y
        cómo te puede ahorrar ese trabajo.
      </p>
    </div>
  </section>

  <ToolFaq items={faqItems} />

  <ToolCrossLinks currentHref="/calcular-precio-venta-margen" />

  <ToolUpsell
    heading="¿Te sirvió la calculadora?"
    body="Esto es solo un producto o un servicio. Rosiv calcula el margen de cada producto o servicio de tu inventario automáticamente, y te avisa cuando alguno se te quedó con un precio que ya no te deja ganancia — sin que tengas que volver a sacar la calculadora."
    features={[
      { icon: "fas fa-boxes-stacked", label: "Margen calculado por producto o servicio" },
      { icon: "fas fa-triangle-exclamation", label: "Alertas cuando un margen se vuelve riesgoso" },
      { icon: "fas fa-bolt", label: "Cobra en segundos desde el celular" },
    ]}
  />

  <Footer />
</Layout>

<script>
  type BizType = "tienda" | "restaurante" | "peluqueria";

  const BIZ_CONFIG: Record<
    BizType,
    { costLabel: string; profitLabel: string; costPlaceholder: string; profitPlaceholder: string; healthy: number; risky: number }
  > = {
    tienda: {
      costLabel: "¿Cuánto te cuesta el producto?",
      profitLabel: "¿Cuánto quieres ganarte por cada uno?",
      costPlaceholder: "2.000",
      profitPlaceholder: "900",
      healthy: 20,
      risky: 10,
    },
    restaurante: {
      costLabel: "¿Cuánto te cuestan los ingredientes del plato?",
      profitLabel: "¿Cuánto quieres ganarte por cada plato?",
      costPlaceholder: "6.000",
      profitPlaceholder: "11.200",
      healthy: 65,
      risky: 45,
    },
    peluqueria: {
      costLabel: "¿Cuánto te cuestan los insumos del servicio?",
      profitLabel: "¿Cuánto quieres ganarte por servicio?",
      costPlaceholder: "5.000",
      profitPlaceholder: "6.200",
      healthy: 55,
      risky: 35,
    },
  };

  let currentBiz: BizType = "tienda";

  const bizChips = document.querySelectorAll<HTMLButtonElement>(".margin-biz-chip");
  const costLabelText = document.getElementById("margin-cost-text") as HTMLElement;
  const profitLabelText = document.getElementById("margin-profit-text") as HTMLElement;
  const costInput = document.getElementById("margin-cost") as HTMLInputElement;
  const profitInput = document.getElementById("margin-profit") as HTMLInputElement;
  const volumeInput = document.getElementById("margin-volume") as HTMLInputElement;
  const errorEl = document.getElementById("margin-error") as HTMLElement;
  const suggestBtn = document.getElementById("margin-suggest-btn") as HTMLButtonElement;
  const suggestText = document.getElementById("margin-suggest-text") as HTMLElement;
  const resultBox = document.getElementById("margin-result") as HTMLElement;
  const priceOutput = document.getElementById("margin-price-output") as HTMLElement;
  const pctOutput = document.getElementById("margin-pct-output") as HTMLElement;
  const signalBox = document.getElementById("margin-signal") as HTMLElement;
  const signalIcon = document.getElementById("margin-signal-icon") as HTMLElement;
  const signalText = document.getElementById("margin-signal-text") as HTMLElement;
  const projectionBox = document.getElementById("margin-projection") as HTMLElement;
  const projectionOutput = document.getElementById("margin-projection-output") as HTMLElement;

  function formatCOP(value: number): string {
    return "$" + Math.round(value).toLocaleString("es-CO");
  }

  function parseNumber(raw: string): number {
    const clean = raw.replace(/\D/g, "");
    return clean ? parseInt(clean, 10) : 0;
  }

  function formatInputDisplay(el: HTMLInputElement) {
    const digits = el.value.replace(/\D/g, "");
    el.value = digits ? parseInt(digits, 10).toLocaleString("es-CO") : "";
  }

  function applyBizConfig(biz: BizType) {
    const config = BIZ_CONFIG[biz];
    costLabelText.textContent = config.costLabel;
    profitLabelText.textContent = config.profitLabel;
    costInput.placeholder = config.costPlaceholder;
    profitInput.placeholder = config.profitPlaceholder;
    costInput.value = config.costPlaceholder;
    profitInput.value = config.profitPlaceholder;
    suggestText.textContent = `Sugerir ganancia sana (${config.healthy}% de margen)`;
  }

  suggestBtn.addEventListener("click", () => {
    const cost = parseNumber(costInput.value);
    if (!cost) {
      errorEl.textContent = "Escribe primero cuánto te cuesta.";
      return;
    }
    const config = BIZ_CONFIG[currentBiz];
    const suggestedProfit = (cost * config.healthy) / (100 - config.healthy);
    profitInput.value = Math.round(suggestedProfit).toLocaleString("es-CO");
    recalculate();
  });

  bizChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      bizChips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      currentBiz = chip.dataset.biz as BizType;
      applyBizConfig(currentBiz);
      recalculate();
    });
  });

  function recalculate() {
    const cost = parseNumber(costInput.value);
    const profit = parseNumber(profitInput.value);
    errorEl.textContent = "";

    if (!cost) {
      resultBox.classList.remove("has-value");
      priceOutput.textContent = "–";
      pctOutput.textContent = "–";
      signalBox.className = "margin-signal";
      signalText.textContent = "Escribe cuánto te cuesta para ver el precio sugerido.";
      signalIcon.className = "fas fa-circle";
      projectionBox.classList.remove("has-value");
      projectionOutput.textContent = "–";
      return;
    }

    const price = cost + profit;
    const pct = price > 0 ? (profit / price) * 100 : 0;

    priceOutput.textContent = formatCOP(price);
    pctOutput.textContent = pct.toFixed(1).replace(".0", "") + "%";
    resultBox.classList.remove("has-value");
    void resultBox.offsetWidth;
    resultBox.classList.add("has-value");

    const config = BIZ_CONFIG[currentBiz];
    signalBox.classList.remove("signal-green", "signal-yellow", "signal-red");
    if (pct >= config.healthy) {
      signalBox.classList.add("signal-green");
      signalIcon.className = "fas fa-circle-check";
      signalText.textContent = `Margen sano para ${bizLabel(currentBiz)} (${config.healthy}% o más).`;
    } else if (pct >= config.risky) {
      signalBox.classList.add("signal-yellow");
      signalIcon.className = "fas fa-triangle-exclamation";
      signalText.textContent = `Un poco justo para ${bizLabel(currentBiz)}. Lo sano es ${config.healthy}% o más.`;
    } else {
      signalBox.classList.add("signal-red");
      signalIcon.className = "fas fa-circle-exclamation";
      signalText.textContent = `Margen riesgoso para ${bizLabel(currentBiz)}. Estás dejando muy poco por unidad.`;
    }

    const volume = parseNumber(volumeInput.value) || 0;
    if (volume > 0) {
      projectionOutput.textContent = formatCOP(profit * volume) + " al mes";
      projectionBox.classList.add("has-value");
    } else {
      projectionOutput.textContent = "–";
      projectionBox.classList.remove("has-value");
    }
  }

  function bizLabel(biz: BizType): string {
    return { tienda: "una tienda", restaurante: "un restaurante", peluqueria: "una peluquería" }[biz];
  }

  [costInput, profitInput].forEach((input) => {
    input.addEventListener("input", () => {
      formatInputDisplay(input);
      recalculate();
    });
  });

  volumeInput.addEventListener("input", () => {
    formatInputDisplay(volumeInput);
    recalculate();
  });

  applyBizConfig(currentBiz);
  recalculate();
</script>

<style>
  .margin-biz-select {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .margin-biz-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--gray-200);
    background: var(--white);
    color: var(--gray-600);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .margin-biz-chip:hover {
    border-color: var(--purple-200);
  }

  .margin-biz-chip.active {
    background: var(--gradient-primary);
    border-color: transparent;
    color: var(--white);
    box-shadow: var(--shadow-purple);
  }

  .margin-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }

  .margin-field {
    min-width: 0;
  }

  .margin-field label {
    display: block;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.3;
    min-height: 2.2em;
  }

  .margin-input-wrap {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 0 0.9rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .margin-input-wrap:focus-within {
    border-color: var(--primary-purple);
    box-shadow: 0 0 0 4px rgba(95, 27, 191, 0.12);
  }

  .margin-input-prefix {
    color: var(--gray-400);
    font-weight: 700;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .margin-input-wrap input {
    flex: 1 1 0%;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    border: none;
    outline: none;
    font-size: 1.15rem;
    padding: 0.75rem 0.5rem;
    font-family: var(--font-primary);
    color: var(--brand-black);
    background: transparent;
  }

  .margin-suggest-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--primary-purple);
    font-weight: 600;
    font-size: 0.82rem;
