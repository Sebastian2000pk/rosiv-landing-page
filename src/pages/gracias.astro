---
import Layout from "../layouts/Layout.astro";

const title = "Pago recibido | Rosiv";
const description = "Estamos confirmando tu pago. Vuelve a Rosiv para seguir usando tu cuenta.";
const path = "/gracias";
---

<Layout title={title} description={description} path={path}>
  <main class="thanks-page">
    <span class="shape shape-ring" aria-hidden="true"></span>
    <span class="shape shape-square" aria-hidden="true"></span>
    <span class="shape shape-dot" aria-hidden="true"></span>
    <span class="shape shape-plus" aria-hidden="true">+</span>
    <span class="shape shape-circle" aria-hidden="true"></span>

    <div class="thanks-card">
      <a href="/" class="thanks-logo" aria-label="Rosiv">
        <img src="/assets/brand/logo-full.png" alt="" width="32" height="32" />
        <span>Rosiv</span>
      </a>

      <div class="thanks-icon">
        <i class="fas fa-check" aria-hidden="true"></i>
      </div>

      <h1>¡Listo, recibimos tu pago!</h1>
      <p>
        Lo estamos confirmando y en unos segundos quedará reflejado en tu
        cuenta. Ya puedes volver a Rosiv.
      </p>

      <a id="return-link" class="btn-primary large" href="https://web.rosivhub.com">
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
        Volver a Rosiv
      </a>

      <p class="thanks-note">
        ¿Algo no cuadra? <a href="https://wa.me/573000000000" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const source = params.get("source");

  const link = document.getElementById("return-link") as HTMLAnchorElement | null;
  if (link && source === "desktop") {
    link.href = "rosiv://open";
  }
</script>

<style>
  .thanks-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-color: var(--gray-50, #f9fafb);
    background-image: radial-gradient(var(--purple-200, #d7c3f2) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    background-position: -14px -14px;
  }

  .thanks-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 35%, rgba(249, 250, 251, 0) 0%, var(--gray-50, #f9fafb) 72%);
    pointer-events: none;
  }

  .shape {
    position: absolute;
    pointer-events: none;
    animation: bob 7s ease-in-out infinite;
  }

  .shape-ring {
    width: 90px;
    height: 90px;
    top: 12%;
    left: 12%;
    border: 3px solid var(--purple-200, #d7c3f2);
    border-radius: 50%;
  }

  .shape-square {
    width: 46px;
    height: 46px;
    bottom: 16%;
    left: 17%;
    background: var(--white, #fff);
    border: 3px solid var(--light-purple, #8d56e6);
    border-radius: 12px;
    transform: rotate(20deg);
    opacity: 0.7;
    animation-delay: -2s;
  }

  .shape-dot {
    width: 16px;
    height: 16px;
    top: 22%;
    right: 16%;
    background: var(--primary-purple, #5f1bbf);
    border-radius: 50%;
    opacity: 0.5;
    animation-delay: -4s;
  }

  .shape-plus {
    top: 68%;
    right: 14%;
    font-family: var(--font-display, "Quicksand", sans-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--purple-200, #d7c3f2);
    animation-delay: -1s;
  }

  .shape-circle {
    width: 60px;
    height: 60px;
    bottom: 10%;
    right: 22%;
    background: var(--purple-100, #eae0fa);
    border-radius: 50%;
    opacity: 0.8;
    animation-delay: -5s;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(6deg); }
  }

  .shape-square {
    animation-name: bob-square;
  }

  @keyframes bob-square {
    0%, 100% { transform: rotate(20deg) translateY(0); }
    50% { transform: rotate(28deg) translateY(-12px); }
  }

  @media (max-width: 700px) {
    .shape {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape {
      animation: none;
    }
  }

  .thanks-card {
    position: relative;
    z-index: 1;
    max-width: 420px;
    width: 100%;
    text-align: center;
    background: var(--white, #fff);
    border-radius: 24px;
    padding: 2.75rem 2.25rem 2.25rem;
    box-shadow: var(--shadow-xl, 0 20px 60px rgba(0, 0, 0, 0.1));
    border: 1px solid var(--purple-100, #eae0fa);
    animation: rise 0.5s ease-out;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .thanks-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    text-decoration: none;
    color: var(--brand-black, #111);
    font-family: var(--font-display, "Quicksand", sans-serif);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .thanks-logo img {
    border-radius: 8px;
  }

  .thanks-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--gradient-primary, linear-gradient(135deg, #5f1bbf, #8d56e6));
    box-shadow: var(--shadow-purple, 0 20px 25px -5px rgba(95, 27, 191, 0.25));
    font-size: 1.5rem;
    color: var(--white, #fff);
    animation: pop 0.5s 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes pop {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: scale(1); }
  }

  .thanks-card h1 {
    font-family: var(--font-display, "Quicksand", sans-serif);
    font-size: 1.6rem;
    margin-bottom: 0.6rem;
    color: var(--brand-black, #1a1a1a);
  }

  .thanks-card > p {
    color: var(--gray-500, #666);
    margin-bottom: 2rem;
    line-height: 1.6;
    font-size: 0.98rem;
  }

  .thanks-card .btn-primary {
    justify-content: center;
    width: 100%;
  }

  .thanks-note {
    margin: 1.5rem 0 0;
    font-size: 0.82rem;
    color: var(--gray-400, #9ca3af);
  }

  .thanks-note a {
    color: var(--primary-purple, #5f1bbf);
    text-decoration: none;
    font-weight: 600;
  }

  .thanks-note a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .thanks-card {
      padding: 2.25rem 1.5rem 1.75rem;
    }
  }
</style>
