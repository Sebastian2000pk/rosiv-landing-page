---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const title = "Calculadora de dígito de verificación del NIT (DV) | Rosiv";
const description =
  "Calcula gratis el dígito de verificación (DV) de tu NIT o cédula con el algoritmo oficial de la DIAN. Resultado al instante, sin registrarte.";
const path = "/calcular-digito-verificacion-nit";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de dígito de verificación del NIT",
    url: new URL(path, Astro.site).toString(),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "COP",
    },
    description,
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "¿Qué es el dígito de verificación del NIT?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Es un número adicional (del 0 al 9) que la DIAN calcula a partir de tu NIT o cédula usando una fórmula matemática. Sirve para confirmar que el número está bien escrito, sin errores de digitación, antes de usarlo en facturas o trámites.",
        },
      },
      {
        "@type": "Question",
        name: "¿El dígito de verificación cambia con el tiempo?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. El dígito de verificación de un mismo NIT o cédula siempre da el mismo resultado, porque sale de una fórmula fija sobre esos números. Si te da distinto cada vez, revisa que estés escribiendo el número base correctamente.",
        },
      },
      {
        "@type": "Question",
        name: "¿Puedo calcular el DV de una cédula o solo de un NIT?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Puedes calcularlo para cualquiera de los dos. La DIAN usa la misma fórmula tanto para el NIT de una empresa como para la cédula de una persona natural registrada en el RUT.",
        },
      },
      {
        "@type": "Question",
        name: "¿Por qué me rechazan la factura electrónica por el dígito de verificación?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Casi siempre es porque el DV no corresponde al NIT ingresado, por un error de digitación al escribirlo. Verifica el número exacto que aparece en el RUT y vuelve a calcular el dígito para confirmarlo.",
        },
      },
    ],
  },
];
---

<Layout title={title} description={description} path={path} keywords="dígito de verificación NIT, calcular DV NIT, dígito de verificación DIAN, calculadora NIT Colombia" jsonLd={jsonLd}>
  <Navbar />

  <section class="dv-hero">
    <div class="container dv-hero-grid">
      <div class="dv-hero-main">
        <h1 class="dv-hero-title">
          ¿Te está frenando el dígito de verificación del NIT?
        </h1>
        <p class="dv-hero-subtitle">
          Escribe el NIT o la cédula y te damos el dígito al instante, con
          la fórmula oficial de la DIAN. Gratis, sin registrarte y sin
          esperar a nadie.
        </p>

        <div class="dv-calculator" role="group" aria-labelledby="dv-calc-label">
          <label id="dv-calc-label" for="dv-input" class="dv-label">
            NIT o cédula, sin puntos ni guiones
          </label>
          <div class="dv-calc-row">
            <input
              id="dv-input"
              class="dv-input"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              placeholder="Ej: 900123456"
              aria-describedby="dv-error"
            />
            <div class="dv-result" aria-live="polite">
              <span class="dv-result-label">DV</span>
              <span id="dv-output" class="dv-result-value">–</span>
            </div>
          </div>
          <p id="dv-error" class="dv-error" role="alert"></p>
          <p id="dv-full" class="dv-full" aria-live="polite"></p>
        </div>

        <div class="dv-benefits" role="list">
          <div class="dv-benefit" role="listitem">
            <i class="fas fa-bolt" aria-hidden="true"></i>
            <span>Resultado en segundos</span>
          </div>
          <div class="dv-benefit" role="listitem">
            <i class="fas fa-check-circle" aria-hidden="true"></i>
            <span>Fórmula oficial DIAN</span>
          </div>
          <div class="dv-benefit" role="listitem">
            <i class="fas fa-gift" aria-hidden="true"></i>
            <span>100% gratis</span>
          </div>
        </div>
      </div>

      <aside class="dv-side" aria-label="Sobre Rosiv">
        <!-- Panel 1: mockup de factura, se completa con el DV calculado -->
        <div class="dv-side-panel dv-panel-invoice" data-panel="invoice" hidden>
