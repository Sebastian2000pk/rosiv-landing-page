---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ToolSidePanel from "../components/tools/ToolSidePanel.astro";
import ToolFaq from "../components/tools/ToolFaq.astro";
import ToolUpsell from "../components/tools/ToolUpsell.astro";
import ToolCrossLinks from "../components/tools/ToolCrossLinks.astro";
import "../styles/tool-page.css";

const title = "Calculadora DV: Dígito de Verificación NIT y RUT Gratis | Rosiv";
const description =
  "Calcula el dígito de verificación (DV) de tu NIT, RUT o cédula con la fórmula oficial de la DIAN (módulo 11). Resultado al instante, sin registrarte ni instalar Excel.";
const path = "/calcular-digito-verificacion-nit";

const faqItems = [
  {
    question: "¿Qué es el dígito de verificación del NIT?",
    answer:
      "Es un número adicional (del 0 al 9) que la DIAN calcula a partir de tu NIT o cédula usando una fórmula matemática. Sirve para confirmar que el número está bien escrito, sin errores de digitación, antes de usarlo en facturas o trámites.",
  },
  {
    question: "¿El dígito de verificación cambia con el tiempo?",
    answer:
      "No. El dígito de verificación de un mismo NIT o cédula siempre da el mismo resultado, porque sale de una fórmula fija sobre esos números. Si te da distinto cada vez, revisa que estés escribiendo el número base correctamente.",
  },
  {
    question: "¿Puedo calcular el DV de una cédula o solo de un NIT?",
    answer:
      "Puedes calcularlo para cualquiera de los dos. La DIAN usa la misma fórmula tanto para el NIT de una empresa como para la cédula de una persona natural registrada en el RUT.",
  },
  {
    question: "¿Por qué me rechazan la factura electrónica por el dígito de verificación?",
    answer:
      "Casi siempre es porque el DV no corresponde al NIT ingresado, por un error de digitación al escribirlo. Verifica el número exacto que aparece en el RUT y vuelve a calcular el dígito para confirmarlo.",
  },
  {
    question: "¿El DV del NIT es el mismo que el DV del RUT?",
    answer:
      "Sí. El RUT es el documento donde la DIAN registra tu NIT junto con su dígito de verificación — no son dos números distintos. Cuando alguien pregunta por el 'DV del RUT' se refiere exactamente al mismo dígito de verificación que corresponde al NIT que aparece en ese RUT.",
  },
  {
    question: "¿Cómo calcular el dígito de verificación en Excel?",
    answer:
      "Se puede armar con fórmulas usando los mismos pesos del módulo 11 que usa la DIAN (3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71, aplicados de derecha a izquierda sobre cada dígito del NIT), sumando los productos y sacando el residuo al dividir entre 11. Es fácil cometer un error de fórmula o de orden de los pesos, así que si solo necesitas el resultado, esta calculadora te lo da al instante sin armar nada.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de dígito de verificación del NIT",
    url: new URL(path, Astro.site).toString(),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "COP",
    },
    description,
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rosiv", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: "Calculadora de dígito de verificación del NIT", item: new URL(path, Astro.site).toString() },
    ],
  },
];
---

<Layout title={title} description={description} path={path} keywords="dígito de verificación NIT, calcular DV NIT, dígito de verificación DIAN, calculadora NIT Colombia, dígito de verificación RUT, calcular dígito de verificación en Excel, calculadora dígito de verificación" jsonLd={jsonLd}>
  <Navbar />

  <section class="tool-hero">
    <div class="container tool-hero-grid">
      <div class="tool-hero-main">
        <span class="status-tag live tool-hero-badge">
          <i class="fas fa-bolt" aria-hidden="true"></i>
          Resultado instantáneo
        </span>
        <h1 class="tool-hero-title">
          Calculadora de dígito de verificación (DV) del NIT
        </h1>
        <p class="tool-hero-subtitle">
          Escribe el NIT o la cédula y te damos el dígito al instante, con
          la fórmula oficial de la DIAN. Gratis, sin registrarte y sin
          esperar a nadie.
        </p>

        <div class="tool-card dv-calculator" role="group" aria-labelledby="dv-calc-label">
          <label id="dv-calc-label" for="dv-input" class="dv-label">
            NIT o cédula, sin puntos ni guiones
          </label>
          <div class="dv-calc-row">
            <input
              id="dv-input"
              class="dv-input"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              placeholder="Ej: 900123456"
              aria-describedby="dv-error"
            />
            <div id="dv-result" class="dv-result" aria-live="polite">
              <span class="dv-result-label">DV</span>
              <span id="dv-output" class="dv-result-value">–</span>
            </div>
          </div>
          <p id="dv-error" class="dv-error" role="alert"></p>
          <div id="dv-full-row" class="dv-full-row">
            <p id="dv-full" class="dv-full" aria-live="polite">Número completo: –</p>
            <button
              id="dv-copy"
              class="dv-copy-btn"
              type="button"
              disabled
              aria-label="Copiar número completo con el dígito de verificación"
            >
              <i class="far fa-copy" aria-hidden="true"></i>
              Copiar
            </button>
          </div>
        </div>

        <div class="tool-benefits" role="list">
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-bolt" aria-hidden="true"></i>
            </div>
            <span>Resultado en segundos</span>
          </div>
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-check-circle" aria-hidden="true"></i>
            </div>
            <span>Fórmula oficial DIAN</span>
          </div>
          <div class="tool-benefit" role="listitem">
            <div class="tool-benefit-icon">
              <i class="fas fa-gift" aria-hidden="true"></i>
            </div>
            <span>100% gratis</span>
          </div>
        </div>
      </div>

      <ToolSidePanel
        eyebrow="Después del DV"
        heading="Ya tienes tu DV. Esto es lo que sigue:"
        items={[
          { label: "Dígito de verificación", done: true },
          { label: "Software autorizado por la DIAN" },
          { label: "Sistema de ventas conectado" },
          { label: "Resolución de facturación vigente" },
        ]}
      />
    </div>
  </section>

  <section class="tool-explain">
    <div class="container tool-explain-inner">
      <h2>¿Qué es el dígito de verificación y por qué importa?</h2>
      <p>
        El dígito de verificación (DV) es un número extra que la DIAN le
        agrega a tu NIT o cédula para confirmar que no tiene errores. Va
        separado por un guion al final: si tu NIT base es
        <strong>900123456</strong>, el número completo sería
        <strong>900123456-8</strong>.
      </p>
      <p>
        No es un número que tú eliges ni que cambia con el tiempo: sale de
        una fórmula matemática fija aplicada sobre tu NIT o cédula. Por eso,
        si al facturar te lo piden y no lo tienes a la mano, siempre lo
        puedes recalcular — nunca lo tienes que "inventar" ni adivinar.
      </p>
      <p>
        Se usa principalmente para <strong>facturación electrónica</strong>:
        si el DV no coincide con el NIT, la DIAN rechaza el documento. Un
        error de un solo dígito puede parar tu facturación del día.
      </p>

      <h3>¿Cómo se calcula manualmente?</h3>
      <p>
        La DIAN usa una fórmula llamada módulo 11. En resumen: cada número
        de tu NIT se multiplica por un peso fijo, se suman todos los
        resultados, esa suma se divide entre 11 y el residuo define tu
        dígito de verificación. Es un cálculo simple, pero fácil de
        equivocarse a mano — por eso existe esta calculadora.
      </p>

      <h3>Cuándo te vas a topar con el DV en el día a día de tu negocio</h3>
      <ul class="tool-list">
        <li>Al registrar o actualizar tu RUT ante la DIAN.</li>
        <li>Al configurar tu sistema de facturación electrónica por primera vez.</li>
        <li>Cuando un proveedor o cliente te pide tu NIT completo con el DV.</li>
        <li>Cuando una factura te queda rechazada y necesitas confirmar que el número esté bien.</li>
      </ul>

      <h3>DV del NIT y DV del RUT: es el mismo número</h3>
      <p>
        No hay diferencia entre "dígito de verificación del NIT" y "dígito de
        verificación del RUT": el RUT es el documento de la DIAN donde queda
        registrado tu NIT junto con ese dígito. Si alguien te pide el DV de
        tu RUT, es el mismo número que calculas aquí a partir de tu NIT o
        cédula.
      </p>

      <h3>¿Se puede calcular en Excel?</h3>
      <p>
        Sí, armando una fórmula con los mismos pesos del módulo 11 que usa la
        DIAN (3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71,
        aplicados de derecha a izquierda), multiplicando cada dígito del NIT
        por su peso, sumando y sacando el residuo de dividir entre 11. Es
        fácil equivocarse en el orden de los pesos o en la fórmula del
        residuo — si solo necesitas el número ya calculado, esta calculadora
        te ahorra armar la hoja de cálculo.
      </p>
    </div>
  </section>

  <ToolFaq items={faqItems} />

  <ToolCrossLinks currentHref="/calcular-digito-verificacion-nit" />

  <ToolUpsell
    heading="¿Te sirvió la calculadora?"
    body="Esto es solo un dolor de cabeza menos. El siguiente es facturar cada venta sin pensarlo. Rosiv genera tu factura electrónica DIAN automáticamente desde el mismo sistema donde cobras — sin volver a calcular nada a mano."
    features={[
      { icon: "fas fa-file-invoice-dollar", label: "Factura electrónica DIAN incluida" },
      { icon: "fas fa-wifi-slash", label: "Funciona con o sin internet" },
      { icon: "fas fa-bolt", label: "Cobra en segundos desde el celular" },
    ]}
  />

  <Footer />
</Layout>

<script>
  const WEIGHTS = [3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71];

  function calculateDV(rawValue: string): number {
    const digits = rawValue.split("").reverse().map(Number);
    let sum = 0;
    for (let i = 0; i < digits.length; i++) {
      sum += digits[i] * WEIGHTS[i];
    }
    const remainder = sum % 11;
    if (remainder === 0 || remainder === 1) return remainder;
    return 11 - remainder;
  }

  const input = document.getElementById("dv-input") as HTMLInputElement;
  const resultBox = document.getElementById("dv-result") as HTMLElement;
  const output = document.getElementById("dv-output") as HTMLElement;
  const errorEl = document.getElementById("dv-error") as HTMLElement;
  const fullRow = document.getElementById("dv-full-row") as HTMLElement;
  const fullEl = document.getElementById("dv-full") as HTMLElement;
  const copyBtn = document.getElementById("dv-copy") as HTMLButtonElement;

  let fullNumber = "";

  input?.addEventListener("input", () => {
    const clean = input.value.replace(/\D/g, "");
    if (clean !== input.value) {
      input.value = clean;
    }

    errorEl.textContent = "";

    if (!clean) {
      output.textContent = "–";
      resultBox.classList.remove("has-value");
      fullRow.classList.remove("has-value");
      fullEl.textContent = "Número completo: –";
      copyBtn.disabled = true;
      fullNumber = "";
      return;
    }

    if (clean.length > 15) {
      errorEl.textContent = "Ese número es demasiado largo para un NIT o cédula.";
      output.textContent = "–";
      resultBox.classList.remove("has-value");
      fullRow.classList.remove("has-value");
      fullEl.textContent = "Número completo: –";
      copyBtn.disabled = true;
      fullNumber = "";
      return;
    }

    const dv = calculateDV(clean);
    output.textContent = String(dv);
    resultBox.classList.remove("pulse");
    void resultBox.offsetWidth;
    resultBox.classList.add("has-value", "pulse");

    fullNumber = `${clean}-${dv}`;
    fullEl.textContent = `Número completo: ${fullNumber}`;
    fullRow.classList.add("has-value");
    copyBtn.disabled = false;
  });

  copyBtn?.addEventListener("click", async () => {
    if (!fullNumber) return;
    try {
      await navigator.clipboard.writeText(fullNumber);
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i> Copiado';
      copyBtn.classList.add("copied");
      setTimeout(() => {
        copyBtn.innerHTML = original;
        copyBtn.classList.remove("copied");
      }, 1600);
    } catch {
      // Clipboard API no disponible; el usuario puede seleccionar el texto manualmente.
    }
  });
</script>

<style>
  .dv-label {
    display: block;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .dv-calc-row {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }

  .dv-input {
    flex: 1;
    min-width: 0;
    font-size: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    font-family: var(--font-primary);
    color: var(--brand-black);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .dv-input:focus {
    outline: none;
    border-color: var(--primary-purple);
    box-shadow: 0 0 0 4px rgba(95, 27, 191, 0.12);
  }

  .dv-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--gray-100);
    color: var(--gray-400);
    border-radius: var(--radius-lg);
    padding: 0.5rem 1.5rem;
    min-width: 90px;
    transition: background 0.25s ease, color 0.25s ease, transform 0.15s ease;
  }

  .dv-result.has-value {
    background: var(--gradient-primary);
    color: var(--white);
    box-shadow: var(--shadow-purple);
  }

  .dv-result.pulse {
    animation: dv-pulse 0.4s ease;
  }

  @keyframes dv-pulse {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .dv-result-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.85;
  }

  .dv-result-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .dv-error {
    color: #d92d20;
    font-size: 0.9rem;
    margin-top: 0.75rem;
    min-height: 1.2em;
  }

  .dv-full-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--gray-200);
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .dv-full-row.has-value {
    opacity: 1;
  }

  .dv-full {
    color: var(--gray-700);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dv-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    background: var(--purple-50);
    color: var(--primary-purple);
    border: 1px solid var(--purple-200);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dv-copy-btn:hover:not(:disabled) {
    background: var(--primary-purple);
    color: var(--white);
    border-color: var(--primary-purple);
  }

  .dv-copy-btn:disabled {
    cursor: default;
  }

  .dv-copy-btn.copied {
    background: #17a34a;
    color: var(--white);
    border-color: #17a34a;
  }

  @media (max-width: 640px) {
    .dv-calc-row {
      flex-direction: column;
    }

    .dv-result {
      flex-direction: row;
      gap: 0.75rem;
      padding: 0.75rem 1.5rem;
    }

    .dv-full-row {
      flex-direction: column;
      align-items: stretch;
    }

    .dv-copy-btn {
      justify-content: center;
    }
  }
</style>
