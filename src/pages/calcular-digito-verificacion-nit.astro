</Layout>

<script>
  const WEIGHTS = [3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71];

  function calculateDV(rawValue: string): number {
    const digits = rawValue.split("").reverse().map(Number);
    let sum = 0;
    for (let i = 0; i < digits.length; i++) {
      sum += digits[i] * WEIGHTS[i];
    }
    const remainder = sum % 11;
    if (remainder === 0 || remainder === 1) return remainder;
    return 11 - remainder;
  }

  const input = document.getElementById("dv-input") as HTMLInputElement;
  const output = document.getElementById("dv-output") as HTMLElement;
  const errorEl = document.getElementById("dv-error") as HTMLElement;
  const fullEl = document.getElementById("dv-full") as HTMLElement;
  const invoiceNit = document.getElementById("dv-invoice-nit") as HTMLElement;

  input?.addEventListener("input", () => {
    const clean = input.value.replace(/\D/g, "");
    if (clean !== input.value) {
      input.value = clean;
    }

    errorEl.textContent = "";

    if (!clean) {
      output.textContent = "–";
      fullEl.textContent = "";
      return;
    }

    if (clean.length > 15) {
      errorEl.textContent = "Ese número es demasiado largo para un NIT o cédula.";
      output.textContent = "–";
      fullEl.textContent = "";
      return;
    }

    const dv = calculateDV(clean);
    output.textContent = String(dv);
    fullEl.textContent = `Número completo: ${clean}-${dv}`;
    if (invoiceNit) invoiceNit.textContent = `${clean}-${dv}`;
  });

  // Panel lateral: se elige uno al azar entre factura / checklist / dato curioso
  const panels = document.querySelectorAll<HTMLElement>(".dv-side-panel");
  if (panels.length > 0) {
    const chosen = panels[Math.floor(Math.random() * panels.length)];
    chosen.hidden = false;
  }
</script>

