---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ToolSidePanel from "../components/tools/ToolSidePanel.astro";
import ToolFaq from "../components/tools/ToolFaq.astro";
import ToolUpsell from "../components/tools/ToolUpsell.astro";
import ToolCrossLinks from "../components/tools/ToolCrossLinks.astro";
import "../styles/tool-page.css";

const title = "¿Debo facturar electrónicamente? Test rápido DIAN 2026 | Rosiv";
const description =
  "Responde 3 preguntas y descubre al instante si tu negocio está obligado a facturar electrónicamente ante la DIAN en 2026. Gratis, sin registrarte.";
const path = "/debo-facturar-electronicamente/";

const faqItems = [
  {
    question: "¿Quién está obligado a facturar electrónicamente en Colombia en 2026?",
    answer:
      "La regla general es que quien vende bienes o presta servicios debe facturar. Están obligados las personas jurídicas, los responsables de IVA, los responsables del impuesto al consumo y quienes pertenecen al Régimen Simple de Tributación, sin importar sus ingresos. La excepción principal son las personas naturales que cumplen todas las condiciones para ser no responsables de IVA (artículo 437 del Estatuto Tributario): ingresos brutos inferiores a 3.500 UVT en el año anterior y en el año en curso, un solo establecimiento, sin franquicias, no ser usuario aduanero, sin contratos ni consignaciones de 3.500 UVT o más, y no estar en el Régimen Simple.",
  },
  {
    question: "¿Un negocio pequeño con pocas ventas debe facturar electrónicamente?",
    answer:
      "Depende de su régimen y de sus condiciones, no solo del tamaño. Si el negocio está inscrito en el Régimen Simple o es responsable de IVA o de impuesto al consumo, debe facturar electrónicamente sin importar cuánto venda. Si es una persona natural que cumple todas las condiciones para ser no responsable de IVA, por regla general no está obligada; pero basta con incumplir una, por ejemplo abrir un segundo local, para quedar obligada. Conviene revisarlo cada año, porque el valor de la UVT cambia.",
  },
  {
    question: "¿Qué pasa si estoy obligado a facturar electrónicamente y no lo hago?",
    answer:
      "La DIAN puede imponer sanciones y desconocer los costos y gastos que no estén soportados con factura electrónica válida. Además, muchos clientes empresariales ya no aceptan facturas que no sean electrónicas, lo que puede hacerte perder ventas.",
  },
  {
    question: "¿La factura POS reemplaza a la factura electrónica?",
    answer:
      "Depende de cuál POS. El documento equivalente electrónico tiquete POS es un documento electrónico válido ante la DIAN: se puede expedir sin importar el valor de la venta y, si identifica al comprador, le da derecho a costos, deducciones e IVA descontable (Resolución DIAN 000165 de 2023 y Concepto DIAN 20900 de 2024). El tiquete POS físico, el de papel, sí tiene un tope de 5 UVT por venta y no da esos derechos. Ninguno de los dos te exime de la obligación de facturar: el documento equivalente es otra forma de cumplirla. Confirma con tu contador cuál te conviene expedir.",
  },
  {
    question: "¿Cuáles son los topes exactos para facturar electrónicamente?",
    answer:
      "Si perteneces al Régimen Simple o eres responsable de IVA o de impuesto al consumo, no hay tope: estás obligado desde el primer peso vendido. Si eres persona natural, el tope de ingresos para ser no responsable de IVA es de 3.500 UVT, medido en el año anterior y en el año en curso: $174.296.500 en 2025 (UVT de $49.799) y $183.309.000 en 2026 (UVT de $52.374). Además del tope, tienes que cumplir las demás condiciones del artículo 437 del Estatuto Tributario.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Test: ¿Debo facturar electrónicamente?",
    url: new URL(path, Astro.site).toString(),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "COP",
    },
    description,
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rosiv", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Test: ¿Debo facturar electrónicamente?", item: new URL(path, Astro.site).toString() },
    ],
  },
];
---

<Layout title={title} description={description} path={path} keywords="debo facturar electrónicamente, obligados factura electrónica DIAN, factura electrónica 2026 Colombia, régimen simple facturación, topes para facturar electrónicamente, tope UVT factura electrónica" jsonLd={jsonLd}>
  <Navbar />

  <section class="tool-hero qz-hero">
    <div class="container tool-hero-grid tool-hero-grid--single">
      <div class="tool-hero-main">
        <span class="status-tag live tool-hero-badge">
          <i class="fas fa-list-check" aria-hidden="true"></i>
          Respuesta en 3 preguntas
        </span>
        <h1 class="tool-hero-title">
          ¿Debo facturar electrónicamente? Test rápido DIAN
        </h1>
        <p class="tool-hero-subtitle">
          3 preguntas cortas y te decimos si te toca, sin leerte la norma
          completa.
        </p>

        <div class="tool-card qz-card" role="group" aria-label="Test de obligación de facturación electrónica">
          <div id="qz-questions">
            <div class="qz-step active" data-step="1">
              <p class="qz-step-label">Pregunta 1 de 3</p>
              <h2 class="qz-question">¿A qué régimen tributario pertenece tu negocio?</h2>
              <div class="qz-options">
                <button type="button" class="qz-option" data-q="1" data-value="simple">Régimen Simple de Tributación</button>
                <button type="button" class="qz-option" data-q="1" data-value="responsable-iva">Responsable de IVA o de impuesto al consumo, o soy una empresa (persona jurídica)</button>
                <button type="button" class="qz-option" data-q="1" data-value="no-responsable">Persona natural, no responsable de IVA</button>
                <button type="button" class="qz-option" data-q="1" data-value="no-se">No estoy seguro</button>
              </div>
            </div>

            <div class="qz-step" data-step="2">
              <p class="qz-step-label">Pregunta 2 de 3</p>
              <h2 class="qz-question">¿Tus ingresos brutos pasaron de 3.500 UVT el año pasado o en lo que va de este año?</h2>
              <p class="qz-hint">3.500 UVT son $174.296.500 en 2025 y $183.309.000 en 2026. Cuenta todo lo que vendiste, no lo que te quedó.</p>
              <div class="qz-options">
                <button type="button" class="qz-option" data-q="2" data-value="alto">Sí, en 2025 o en lo que va de 2026</button>
                <button type="button" class="qz-option" data-q="2" data-value="bajo">No, estuve por debajo en los dos años</button>
                <button type="button" class="qz-option" data-q="2" data-value="no-se">No estoy seguro</button>
              </div>
            </div>

            <div class="qz-step" data-step="3">
              <p class="qz-step-label">Pregunta 3 de 3</p>
              <h2 class="qz-question">¿Te aplica alguna de estas situaciones?</h2>
              <p class="qz-hint">Más de un local o negocio, operar con franquicia o concesión, ser usuario aduanero, o haber firmado un contrato o recibido consignaciones por 3.500 UVT o más (en 2025 o en 2026).</p>
              <div class="qz-options">
                <button type="button" class="qz-option" data-q="3" data-value="si">Sí, al menos una</button>
                <button type="button" class="qz-option" data-q="3" data-value="no">No, ninguna</button>
                <button type="button" class="qz-option" data-q="3" data-value="no-se">No estoy seguro</button>
              </div>
            </div>
          </div>

          <div id="qz-result" class="qz-result" role="status" aria-live="polite">
            <div id="qz-result-icon" class="qz-result-icon">
              <i class="fas fa-file-invoice" aria-hidden="true"></i>
            </div>
            <h2 id="qz-result-title" class="qz-result-title">—</h2>
            <p id="qz-result-text" class="qz-result-text">—</p>
            <button type="button" id="qz-restart" class="qz-restart-btn">
              <i class="fas fa-rotate-left" aria-hidden="true"></i>
              Volver a empezar
            </button>
          </div>

          <div class="qz-progress" aria-hidden="true">
            <span class="qz-dot active" data-dot="1"></span>
            <span class="qz-dot" data-dot="2"></span>
            <span class="qz-dot" data-dot="3"></span>
          </div>
        </div>

        <ToolSidePanel
          inline
          eyebrow="Si estás obligado"
          heading="Esto es lo que necesitas para facturar bien:"
          items={[
            { label: "Saber que estás obligado", done: true },
            { label: "Software autorizado" },
            { label: "Sistema de ventas conectado" },
            { label: "Resolución vigente" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="tool-explain">
    <div class="container tool-explain-inner">
      <h2>Quién está obligado a facturar electrónicamente en Colombia</h2>
      <p>
        La obligación de facturar electrónicamente no depende solo del
        tamaño del negocio, sino principalmente de tu
        <strong>régimen tributario</strong>. Si estás inscrito en el
        Régimen Simple de Tributación, estás obligado sin importar cuánto
        vendas, aunque no cobres IVA. Si eres responsable de IVA o de
        impuesto al consumo, o si tu negocio es una persona jurídica, también
        aplica para ti.
      </p>
      <p>
        Si eres persona natural, por regla general no estás obligado solo si
        cumples <strong>todas</strong> las condiciones para ser no responsable
        de IVA: ingresos brutos inferiores a <strong>3.500 UVT</strong> en el
        año anterior y en el año en curso, un solo local o negocio, sin
        franquicias, no ser usuario aduanero, sin contratos ni consignaciones
        de 3.500 UVT o más y no estar en el Régimen Simple. Las 3.500 UVT no
        cambian; su valor en pesos sí, porque la UVT se actualiza cada enero.
      </p>

      <h3>El tiquete POS: físico o electrónico</h3>
      <p>
        El documento equivalente POS no te exime de facturar: es otra forma
        de cumplir esa obligación. Hoy existen dos. El
        <strong>documento equivalente electrónico tiquete POS</strong> se
        transmite a la DIAN, se puede expedir sin importar el valor de la
        venta y, si identifica al comprador con su nombre y su número de
        identificación, le sirve para costos, deducciones e IVA descontable
        (Concepto DIAN 20900 de 2024). El <strong>tiquete POS físico</strong>,
        el de papel, solo sirve para ventas de hasta 5 UVT y no da esos
        derechos. La diferencia completa está en <a href="/blog/documento-equivalente-pos-vs-factura-electronica/">documento equivalente POS vs. factura electrónica</a>.
      </p>

      <h3>Los topes exactos para facturar electrónicamente</h3>
      <ul class="tool-list">
        <li><strong>Régimen Simple de Tributación:</strong> sin tope de ingresos — obligado desde el primer peso vendido.</li>
        <li><strong>Responsable de IVA o de impuesto al consumo:</strong> sin tope de ingresos — obligado sin importar cuánto factures.</li>
        <li><strong>Persona natural no responsable de IVA:</strong> ingresos brutos inferiores a <strong>3.500 UVT</strong> en el año anterior y en el año en curso: $174.296.500 en 2025 (UVT de $49.799) y $183.309.000 en 2026 (UVT de $52.374), además de las demás condiciones. Si las cumples todas, por regla general no estás obligado (aunque puedes facturar electrónicamente por decisión propia).</li>
        <li><strong>Tiquete POS físico:</strong> solo para ventas de hasta 5 UVT. El documento equivalente electrónico tiquete POS no tiene ese tope.</li>
      </ul>
      <p>
        Estos topes se miden en UVT, no en pesos fijos, porque la UVT se
        actualiza cada año. El detalle de cada condición está en <a href="/blog/topes-para-facturar-electronicamente/">los topes para facturar electrónicamente</a>.
      </p>

      <h3>Qué hacer si el test te dice que ya estás obligado</h3>
      <ul class="tool-list">
        <li>Confirma tu situación puntual con tu contador antes de tomar decisiones.</li>
        <li>Revisa que tu RUT tenga el régimen y las responsabilidades correctas.</li>
        <li>Habilítate como facturador electrónico en el portal de la DIAN y solicita la numeración autorizada. Los pasos están en <a href="/blog/facturar-electronicamente-tienda-de-barrio/">cómo empezar a facturar electrónicamente en tu negocio</a>.</li>
        <li>Elige cómo vas a facturar: el servicio gratuito de la DIAN o un sistema con proveedor tecnológico que se conecte con tus ventas del día a día.</li>
        <li>Empieza a facturar electrónicamente cuanto antes: entre más esperes, más facturas quedan sin soporte válido.</li>
      </ul>
    </div>
  </section>

  <ToolFaq items={faqItems} />

  <ToolCrossLinks currentHref="/debo-facturar-electronicamente/" />

  <ToolUpsell
    heading="¿Ya sabes que te toca facturar electrónicamente?"
    body="No necesitas volverte experto en normas DIAN. Desde el plan Starter, Rosiv emite tu factura electrónica desde el mismo sistema donde cobras, a través de un proveedor tecnológico habilitado que ya viene integrado."
    features={[
      { icon: "fas fa-file-invoice-dollar", label: "Factura electrónica DIAN incluida" },
      { icon: "fas fa-plane", label: "Funciona con o sin internet" },
      { icon: "fas fa-bolt", label: "Cobra en segundos desde el celular" },
    ]}
  />

  <Footer />
</Layout>

<script>
  type Answers = { q1?: string; q2?: string; q3?: string };
  const answers: Answers = {};
  let currentStep = 1;

  const steps = document.querySelectorAll<HTMLElement>(".qz-step");
  const dots = document.querySelectorAll<HTMLElement>(".qz-dot");
  const questionsWrap = document.getElementById("qz-questions") as HTMLElement;
  const resultBox = document.getElementById("qz-result") as HTMLElement;
  const resultIcon = document.getElementById("qz-result-icon") as HTMLElement;
  const resultTitle = document.getElementById("qz-result-title") as HTMLElement;
  const resultText = document.getElementById("qz-result-text") as HTMLElement;
  const restartBtn = document.getElementById("qz-restart") as HTMLButtonElement;
  const progressBar = document.querySelector(".qz-progress") as HTMLElement;

  function goToStep(step: number) {
    currentStep = step;
    steps.forEach((s) => s.classList.toggle("active", Number(s.dataset.step) === step));
    dots.forEach((d) => d.classList.toggle("active", Number(d.dataset.dot) === step));
  }

  function evaluate(): { title: string; text: string; obligated: boolean } {
    const { q1, q2, q3 } = answers;

    if (q1 === "simple") {
      return {
        title: "Sí, estás obligado a facturar electrónicamente",
        text: "Al pertenecer al Régimen Simple de Tributación, debes facturar electrónicamente sin importar cuánto vendas al año.",
        obligated: true,
      };
    }

    if (q1 === "responsable-iva") {
      return {
        title: "Sí, estás obligado a facturar electrónicamente",
        text: "Si eres responsable de IVA o de impuesto al consumo, o tu negocio es una persona jurídica, debes expedir factura electrónica (o documento equivalente electrónico) en tus ventas, sin importar cuánto vendas.",
        obligated: true,
      };
    }

    if (q2 === "alto") {
      return {
        title: "Es muy probable que ya estés obligado",
        text: "Si tus ingresos brutos pasaron de 3.500 UVT en el año anterior o en el año en curso, no cumples las condiciones para ser no responsable de IVA, y como responsable de IVA debes facturar electrónicamente. Confírmalo con tu contador.",
        obligated: true,
      };
    }

    if (q3 === "si") {
      return {
        title: "Es muy probable que ya estés obligado",
        text: "Para ser no responsable de IVA hay que cumplir todas las condiciones a la vez. Tener más de un local, operar con franquicia, ser usuario aduanero o tener contratos o consignaciones de 3.500 UVT o más te hace responsable de IVA, y por tanto obligado a facturar, aunque vendas poco. Confírmalo con tu contador.",
        obligated: true,
      };
    }

    if (q1 === "no-se" || q2 === "no-se" || q3 === "no-se") {
      return {
        title: "No estamos seguros con la información que diste",
        text: "Con datos más precisos sobre tu régimen tributario e ingresos anuales podemos darte una respuesta más clara. Te recomendamos confirmarlo con tu contador o en el portal de la DIAN.",
        obligated: false,
      };
    }

    return {
      title: "Por ahora no estarías obligado",
      text: "Con lo que nos cuentas, cumplirías las condiciones para ser no responsable de IVA y, por regla general, no estarías obligado a facturar electrónicamente. Revísalo cada año con tu contador: el valor de la UVT cambia, y tu situación también (por ejemplo, si abres otro local o te inscribes en el Régimen Simple).",
      obligated: false,
    };
  }

  function showResult() {
    questionsWrap.classList.add("hidden");
    progressBar.classList.add("hidden");
    resultBox.classList.add("visible");

    const { title, text, obligated } = evaluate();
    resultTitle.textContent = title;
    resultText.textContent = text;
    resultIcon.classList.toggle("obligated", obligated);
    resultIcon.innerHTML = obligated
      ? '<i class="fas fa-triangle-exclamation" aria-hidden="true"></i>'
      : '<i class="fas fa-circle-check" aria-hidden="true"></i>';
  }

  document.querySelectorAll<HTMLButtonElement>(".qz-option").forEach((btn) => {
    btn.addEventListener("click", () => {
      const q = btn.dataset.q;
      const value = btn.dataset.value;
      if (q === "1") answers.q1 = value;
      if (q === "2") answers.q2 = value;
      if (q === "3") answers.q3 = value;

      if (currentStep < 3) {
        goToStep(currentStep + 1);
      } else {
        showResult();
      }
    });
  });

  restartBtn?.addEventListener("click", () => {
    answers.q1 = undefined;
    answers.q2 = undefined;
    answers.q3 = undefined;
    resultBox.classList.remove("visible");
    questionsWrap.classList.remove("hidden");
    progressBar.classList.remove("hidden");
    goToStep(1);
  });
</script>

<style>
  .qz-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1.75rem;
  }

  .qz-step {
    display: none;
  }

  .qz-step.active {
    display: block;
    animation: qz-fade-in 0.35s ease;
  }

  @keyframes qz-fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .qz-step-label {
    color: var(--primary-purple);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
  }

  .qz-question {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--brand-black);
    margin-bottom: 0.9rem;
    line-height: 1.3;
  }

  .qz-hint {
    color: var(--gray-600);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: -0.4rem 0 0.9rem;
  }

  .qz-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qz-option {
    text-align: left;
    background: var(--gray-50);
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--gray-700);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .qz-option:hover {
    border-color: var(--primary-purple);
    background: var(--purple-50);
    color: var(--brand-black);
  }

  .qz-progress {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .qz-progress.hidden {
    display: none;
  }

  .qz-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gray-200);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .qz-dot.active {
    background: var(--primary-purple);
    transform: scale(1.3);
  }

  #qz-questions.hidden {
    display: none;
  }

  .qz-result {
    display: none;
    text-align: center;
    padding: 1rem 0;
  }

  .qz-result.visible {
    display: block;
    animation: qz-fade-in 0.4s ease;
  }

  .qz-result-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--purple-50);
    color: var(--primary-purple);
    font-size: 1.75rem;
  }

  .qz-result-icon.obligated {
    background: #fef3c7;
    color: #b45309;
  }

  .qz-result-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--brand-black);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .qz-result-text {
    color: var(--gray-600);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .qz-restart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gray-100);
    color: var(--gray-700);
    border: none;
    border-radius: var(--radius-md);
    padding: 0.7rem 1.25rem;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .qz-restart-btn:hover {
    background: var(--gray-200);
  }
</style>
