---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ToolCrossLinks from "../components/tools/ToolCrossLinks.astro";

// GitHub Pages sirve dist/404.html con status 404 real para cualquier URL que
// no exista. El noindex es redundante con el 404, pero no estorba.
const title = "Página no encontrada | Rosiv";
const description = "Esta página no existe o se movió. Vuelve al inicio o usa una de las herramientas gratis de Rosiv.";
---

<Layout title={title} description={description} path="/404/" noindex>
  <Navbar />

  <main class="not-found">
    <div class="container not-found-inner">
      <div class="not-found-code" aria-hidden="true">404</div>
      <h1>Esta página no existe o se movió</h1>
      <p>
        Puede que el enlace esté mal escrito o que el artículo haya cambiado de
        dirección. Desde aquí puedes seguir:
      </p>
      <div class="not-found-actions">
        <a class="btn-primary" href="/">Ir al inicio</a>
        <a class="btn-secondary" href="/blog/">Ver el blog</a>
      </div>
    </div>
  </main>

  <ToolCrossLinks label="O usa una de las herramientas gratis" />

  <Footer />
</Layout>

<style>
  .not-found {
    padding: 140px 0 40px;
    text-align: center;
  }

  .not-found-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .not-found-code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--primary-purple);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .not-found h1 {
    font-size: 1.75rem;
    color: var(--brand-black);
    margin-bottom: 1rem;
  }

  .not-found p {
    color: var(--gray-600);
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
</style>
