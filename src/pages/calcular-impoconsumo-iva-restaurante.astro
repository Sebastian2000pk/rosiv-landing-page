---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ToolSidePanel from "../components/tools/ToolSidePanel.astro";
import ToolFaq from "../components/tools/ToolFaq.astro";
import ToolUpsell from "../components/tools/ToolUpsell.astro";
import ToolCrossLinks from "../components/tools/ToolCrossLinks.astro";
import "../styles/tool-page.css";

const title = "Calculadora de Impoconsumo (8%) vs IVA (19%) para restaurantes | Rosiv";
const description =
  "¿Tu restaurante debe cobrar impoconsumo del 8% o IVA del 19%? Calcula el valor exacto al instante y entiende cuál impuesto te corresponde según tu negocio.";
const path = "/calcular-impoconsumo-iva-restaurante";

const faqItems = [
  {
    question: "¿Mi restaurante cobra impoconsumo (8%) o IVA (19%)?",
    answer:
      "La mayoría de restaurantes, bares y establecimientos que venden comida y bebidas preparadas para consumo cobran el impuesto al consumo del 8%. El IVA del 19% aplica cuando el negocio funciona bajo franquicia o cuando la venta no corresponde a servicio de restaurante como tal (por ejemplo, venta de productos empacados). Si tienes dudas sobre tu caso puntual, confírmalo con tu contador.",
  },
  {
    question: "¿La propina cuenta para calcular el impoconsumo?",
    answer:
      "No. La propina es voluntaria y es un ingreso del trabajador, no del establecimiento, así que nunca debe sumarse a la base sobre la que se calcula el 8% de impoconsumo.",
  },
  {
    question: "¿Un restaurante puede cobrar impoconsumo e IVA al mismo tiempo?",
    answer:
      "No sobre el mismo producto. Un restaurante que solo presta el servicio de alimentos y bebidas preparadas cobra impoconsumo del 8% y no IVA. Si el mismo negocio vende también otros productos que no son parte del servicio de restaurante (por ejemplo, mercancía empacada para llevar), esos ítems sí pueden estar gravados con IVA del 19% en vez de impoconsumo.",
  },
  {
    question: "¿Qué pasa si cobro el impuesto equivocado en mi restaurante?",
    answer:
      "Si facturas con la tarifa equivocada, la DIAN puede rechazar tus reportes o generar diferencias en tu declaración de impuestos. Es importante confirmar con tu contador cuál tarifa aplica a tu negocio específico y configurarla bien en tu sistema de facturación desde el inicio.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de Impoconsumo vs IVA para restaurantes",
    url: new URL(path, Astro.site).toString(),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "COP",
    },
    description,
    publisher: {
      "@type": "Organization",
      name: "Rosiv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Rosiv", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: "Calculadora de Impoconsumo vs IVA para restaurantes", item: new URL(path, Astro.site).toString() },
    ],
  },
];
---

<Layout title={title} description={description} path={path} keywords="impoconsumo restaurante, calculadora impoconsumo, IVA restaurante Colombia, impuesto al consumo 8%, impoconsumo vs IVA" jsonLd={jsonLd}>
  <Navbar />

  <section class="tool-hero ic-hero">
    <div class="container tool-hero-grid">
      <div class="tool-hero-main">
        <span class="status-tag live tool-hero-badge">
          <i class="fas fa-scale-balanced" aria-hidden="true"></i>
          Compara las dos tarifas a la vez
        </span>
        <h1 class="tool-hero-title">
          ¿Impoconsumo del 8% o IVA del 19% en tu restaurante?
        </h1>
        <p class="tool-hero-subtitle">
          Escribe el valor de la cuenta y mira el total con las dos tarifas
          al mismo tiempo. Sin registrarte.
        </p>

        <div class="tool-card ic-calculator" role="group" aria-labelledby="ic-calc-label">
          <label id="ic-calc-label" for="ic-input" class="ic-label">
            Valor de la cuenta antes de impuestos
          </label>
          <div class="ic-input-wrap">
            <span class="ic-input-prefix">$</span>
            <input
              id="ic-input"
              class="ic-input"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              placeholder="Ej: 50.000"
              aria-describedby="ic-error"
            />
          </div>
          <p id="ic-error" class="ic-error" role="alert"></p>

          <div class="ic-versus">
            <div id="ic-card-8" class="ic-rate-card ic-rate-card--suggested">
              <span class="ic-rate-tag">Lo más común en restaurantes</span>
              <span class="ic-rate-pct">8%</span>
              <span class="ic-rate-name">Impoconsumo</span>
              <span class="ic-rate-total" id="ic-total-8">$0</span>
              <span class="ic-rate-hint">Total a cobrar</span>
            </div>
            <div id="ic-card-19" class="ic-rate-card">
              <span class="ic-rate-tag ic-rate-tag--muted">Franquicias y otros casos</span>
              <span class="ic-rate-pct">19%</span>
              <span class="ic-rate-name">IVA</span>
              <span class="ic-rate-total" id="ic-total-19">$0</span>
              <span class="ic-rate-hint">Total a cobrar</span>
            </div>
          </div>
        </div>
      </div>

      <ToolSidePanel
        eyebrow="Después de saber tu tarifa"
        heading="Ya sabes qué impuesto cobrar. Esto es lo que sigue:"
        items={[
          { label: "Tarifa correcta identificada", done: true },
          { label: "Configurarla en tu sistema de ventas" },
          { label: "Facturar electrónicamente sin errores" },
          { label: "Reportar a la DIAN sin sustos" },
        ]}
      />
    </div>
  </section>

  <section class="tool-explain">
    <div class="container tool-explain-inner">
      <h2>¿Impoconsumo o IVA? Cómo saber cuál te corresponde</h2>
      <p>
        En Colombia, los restaurantes, bares, cafeterías y negocios que
        prestan servicio de alimentos y bebidas preparadas para consumo
        generalmente cobran el <strong>impuesto al consumo (impoconsumo) del
        8%</strong>, no el IVA del 19%. Es uno de los errores más comunes al
        facturar: muchos negocios nuevos cobran IVA por costumbre, cuando en
        realidad les corresponde impoconsumo.
      </p>
      <p>
        El <strong>IVA del 19%</strong> sí aplica en casos como restaurantes
        que operan bajo franquicia, o cuando el negocio vende productos que no
        hacen parte del servicio de restaurante (por ejemplo, mercancía
        empacada). Si tu negocio combina servicio de mesa con venta de otros
        productos, es posible que factures con las dos tarifas según el ítem.
      </p>

      <h3>La propina nunca entra en la base del impuesto</h3>
      <p>
        La propina voluntaria (usualmente el 10%) es un ingreso que le
        pertenece al trabajador, no al restaurante. Por eso nunca debe
        sumarse a la base sobre la que se calcula el impoconsumo o el IVA —
        se calcula aparte, sobre el valor del consumo antes de propina.
      </p>

      <h3>Por qué importa cobrar la tarifa correcta desde el día uno</h3>
      <ul class="tool-list">
        <li>Si facturas con la tarifa equivocada, tu declaración de impuestos queda mal desde la base.</li>
        <li>Corregir facturas ya emitidas es más trabajo que configurar bien el sistema desde el inicio.</li>
        <li>Tu contador necesita saber qué tarifa manejas para reportarte correctamente a la DIAN.</li>
        <li>Un cliente que revisa su factura puede notar el error y perder confianza en tu negocio.</li>
      </ul>
    </div>
  </section>

  <ToolFaq items={faqItems} />

  <ToolCrossLinks currentHref="/calcular-impoconsumo-iva-restaurante" />

  <ToolUpsell
    heading="¿Te sirvió la calculadora?"
    body="Configurar bien tu tarifa es solo el primer paso. Rosiv aplica el impuesto correcto automáticamente en cada venta y genera tu factura electrónica DIAN sin que tengas que calcular nada a mano."
    features={[
      { icon: "fas fa-file-invoice-dollar", label: "Factura electrónica DIAN incluida" },
      { icon: "fas fa-percent", label: "Impoconsumo o IVA preconfigurado" },
      { icon: "fas fa-bolt", label: "Cobra en segundos desde el celular" },
    ]}
  />

  <Footer />
</Layout>

<script>
  function parseAmount(raw: string): number {
    const clean = raw.replace(/[^\d]/g, "");
    return clean ? parseInt(clean, 10) : 0;
  }

  function formatCOP(value: number): string {
    return "$" + Math.round(value).toLocaleString("es-CO");
  }

  const input = document.getElementById("ic-input") as HTMLInputElement;
  const errorEl = document.getElementById("ic-error") as HTMLElement;
  const total8 = document.getElementById("ic-total-8") as HTMLElement;
  const total19 = document.getElementById("ic-total-19") as HTMLElement;
  const card8 = document.getElementById("ic-card-8") as HTMLElement;
  const card19 = document.getElementById("ic-card-19") as HTMLElement;

  function render() {
    const base = parseAmount(input.value);

    if (input.value && base === 0) {
      errorEl.textContent = "Escribe un valor numérico válido.";
    } else {
      errorEl.textContent = "";
    }

    total8.textContent = formatCOP(base * 1.08);
    total19.textContent = formatCOP(base * 1.19);

    card8.classList.toggle("has-value", base > 0);
    card19.classList.toggle("has-value", base > 0);
  }

  input?.addEventListener("input", () => {
    const cursorFromEnd = input.value.length - (input.selectionStart ?? input.value.length);
    const digits = input.value.replace(/\D/g, "");
    const formatted = digits ? parseInt(digits, 10).toLocaleString("es-CO") : "";
    input.value = formatted;
    const pos = Math.max(0, input.value.length - cursorFromEnd);
    input.setSelectionRange(pos, pos);
    render();
  });

  render();
</script>

<style>
  .ic-label {
    display: block;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: 0.65rem;
    font-size: 0.92rem;
  }

  .ic-input-wrap {
    display: flex;
    align-items: center;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 0 1.1rem;
    margin-bottom: 1.25rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ic-input-wrap:focus-within {
    border-color: var(--primary-purple);
    box-shadow: 0 0 0 4px rgba(95, 27, 191, 0.12);
  }

  .ic-input-prefix {
    color: var(--gray-400);
    font-size: 1.4rem;
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .ic-input {
    flex: 1;
    min-width: 0;
    font-size: 1.4rem;
    padding: 0.75rem 0;
    border: none;
    outline: none;
    font-family: var(--font-primary);
    color: var(--brand-black);
    background: transparent;
  }

  .ic-error {
    color: #d92d20;
    font-size: 0.9rem;
    margin-top: -0.9rem;
    margin-bottom: 0.75rem;
    min-height: 1.2em;
  }

  .ic-versus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .ic-rate-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--gray-50);
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 1.1rem 0.75rem;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .ic-rate-card--suggested {
    background: var(--purple-50);
    border-color: var(--purple-200);
  }

  .ic-rate-tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--primary-purple);
    margin-bottom: 0.5rem;
    min-height: 2.2em;
    display: flex;
    align-items: center;
  }

  .ic-rate-tag--muted {
    color: var(--gray-400);
  }

  .ic-rate-pct {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-black);
    line-height: 1;
  }

  .ic-rate-name {
    font-size: 0.85rem;
    color: var(--gray-500);
    margin-top: 0.15rem;
    margin-bottom: 0.85rem;
  }

  .ic-rate-total {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gray-400);
    transition: color 0.2s ease;
  }

  .ic-rate-card.has-value .ic-rate-total {
    color: var(--brand-black);
  }

  .ic-rate-card--suggested.has-value .ic-rate-total {
    color: var(--primary-purple);
  }

  .ic-rate-hint {
    font-size: 0.72rem;
    color: var(--gray-400);
    margin-top: 0.15rem;
  }

  @media (max-width: 480px) {
    .ic-rate-pct {
      font-size: 1.6rem;
    }

    .ic-rate-total {
      font-size: 1rem;
    }
  }
</style>
